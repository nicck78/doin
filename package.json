{
  "name": "doin",
  "version": "1.0.0",
  "description": "A clean, modern Windows desktop app for todos, multi-day visual timeline, focus timer, and daily review.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron electron/dev.cjs",
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "package": "node scripts/package-desktop.cjs"
  },
  "keywords": [
    "todo",
    "focus",
    "timer",
    "electron",
    "react"
  ],
  "author": "doin team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
